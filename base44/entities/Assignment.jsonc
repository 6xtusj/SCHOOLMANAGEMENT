{
  "name": "Assignment",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "subject",
        "form"
      ],
      "default": "subject"
    },
    "teacher_email": {
      "type": "string"
    },
    "teacher_name": {
      "type": "string"
    },
    "class_arm_id": {
      "type": "string"
    },
    "class_arm_name": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "subject_name": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "teacher_email",
    "class_arm_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "principal"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        },
        {
          "data.teacher_email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "principal"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}