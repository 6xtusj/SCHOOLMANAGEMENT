# Set a long random value before exposing the app beyond your local machine.
SECRET_KEY=replace-with-a-long-random-secret
HOST=127.0.0.1
PORT=5000
# Optional PostgreSQL/Neon URL. Leave blank for the local SQLite fallback.
# Use a dedicated Neon development URL here; configure production separately in Render.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=
# Optional: SCHOOL_DB_PATH=C:\SchoolData\school.db
# Local files are convenient for development. Render's Free plan should use S3-compatible storage.
UPLOAD_STORAGE=local
# Production example: UPLOAD_STORAGE=s3 and S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
# Connection pool (PostgreSQL only)
DB_POOL_MIN=1
DB_POOL_MAX=8
DB_POOL_TIMEOUT=10
DB_POOL_MAX_IDLE=300
DB_POOL_RECONNECT_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=school-uploads
# Comma-separated exact browser origins only when the frontend is hosted separately.
CORS_ALLOWED_ORIGINS=

# Outgoing email. Configure the provider in Admin → School Settings or set its server environment values.
# Render Free blocks outbound SMTP; use EMAIL_PROVIDER=brevo or EMAIL_PROVIDER=resend there.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
# Sender address for any provider (SMTP_FROM remains supported for older setups).
EMAIL_FROM=
SMTP_FROM=
BREVO_API_KEY=
RESEND_API_KEY=
# Gmail API uses OAuth credentials and a refresh token, not a Gmail API key.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Set this to the address staff/parents can reach from their devices.
# For local-only testing leave it as http://127.0.0.1:5000
PUBLIC_BASE_URL=http://127.0.0.1:5000
# Production only: set APP_ENV=production and use a unique long SECRET_KEY.
APP_ENV=development
COOKIE_SECURE=false

# Paystack online payments. Use test keys during development; never put secret keys in frontend code.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_test_secret
# Configure this exact endpoint as the Paystack webhook URL after deployment:
# https://your-school-domain.example/api/payments/paystack/webhook
