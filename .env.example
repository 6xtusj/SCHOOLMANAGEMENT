# Set a long random value before exposing the app beyond your local machine.
SECRET_KEY=replace-with-a-long-random-secret
HOST=127.0.0.1
PORT=5000
# Optional: SCHOOL_DB_PATH=C:\SchoolData\school.db

# Outgoing email. Configure the provider in Admin → School Settings or set its server environment values.
# Render Free blocks outbound SMTP; use EMAIL_PROVIDER=brevo or EMAIL_PROVIDER=resend there.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
# Sender address for any provider (SMTP_FROM remains supported for older setups).
EMAIL_FROM=
SMTP_FROM=
BREVO_API_KEY=
RESEND_API_KEY=
# Gmail API uses OAuth credentials and a refresh token, not a Gmail API key.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Set this to the address staff/parents can reach from their devices.
# For local-only testing leave it as http://127.0.0.1:5000
PUBLIC_BASE_URL=http://127.0.0.1:5000
# Production only: set APP_ENV=production and use a unique long SECRET_KEY.
APP_ENV=development
COOKIE_SECURE=false

# Paystack online payments. Use test keys during development; never put secret keys in frontend code.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_test_secret
# Configure this exact endpoint as the Paystack webhook URL after deployment:
# https://your-school-domain.example/api/payments/paystack/webhook
