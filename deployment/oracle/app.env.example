# Copy this file to the project root as .env and replace every example value.
# Generate a secret with: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters

# This single-VM profile intentionally uses the named persistent Docker volume.
# For multi-instance/portable production, use PostgreSQL + private S3-compatible storage instead.
ALLOW_SQLITE_IN_PRODUCTION=true
ALLOW_LOCAL_UPLOADS_IN_PRODUCTION=true

# Public domain name, without https://. Point its DNS A record to the Oracle VM.
DOMAIN=school.example.com
# Optional: set this to your Netlify site URL if Netlify will be the public frontend.
# Example: PUBLIC_BASE_URL=https://your-school.netlify.app

# Optional outgoing email configuration. Without it, email is not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional online payment configuration. Keep the secret key private.
PAYSTACK_SECRET_KEY=
